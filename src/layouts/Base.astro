---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  image?: string;
}
const {
  title = 'Isaac Adelore, frontend engineer',
  description = 'Senior frontend engineer in Lagos. I design and build interfaces for sportsbooks, payments and communication tools.',
  image = '/og.jpg',
} = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL(image, Astro.site);
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" href="/favicon-32.png" type="image/png" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="theme-color" content="#efece4" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <header class="wrap site-head">
      <a class="name" href="/">Isaac Adelore</a>
      <nav aria-label="Main">
        <a href="/#work">Work</a>
        <a href="/#experience">Experience</a>
        <a href="/#about">About</a>
        <a href="/cv.pdf">CV</a>
      </nav>
    </header>
    <main id="main">
      <slot />
    </main>
    <footer class="wrap site-foot" id="contact">
      <a class="mail" href="mailto:adeloreisaac@gmail.com">adeloreisaac@gmail.com</a>
      <div class="row">
        <p>Isaac Adelore, Lagos</p>
        <ul>
          <li><a href="https://linkedin.com/in/adeloreisaac">LinkedIn</a></li>
          <li><a href="https://github.com/loluskii">GitHub</a></li>
          <li><a href="/cv.pdf">CV</a></li>
        </ul>
      </div>
    </footer>
  </body>
</html>
