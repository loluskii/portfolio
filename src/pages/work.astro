---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
---

<Layout title="Work">
  <Nav activePage="work" />

  <section class="page-hero">
    <div class="ph-inner">
      <div class="ph-label" id="phl"><span class="ph-line"></span>Our work</div>
      <h1 id="phh">Products built<br />to <em>earn their place.</em></h1>
      <p id="php">Three live products. Three different industries. Three completely different visual identities — each designed and built from scratch to feel exactly right for the problem it solves.</p>
    </div>
  </section>

  <!-- PROJECT 01: ZELA -->
  <div class="project">
    <div class="proj-inner">
      <div class="proj-text reveal">
        <span class="proj-tag">Case study 01</span>
        <h2>Zela — <em>Cross-border payments</em></h2>
        <div class="proj-industry">Fintech · Payments infrastructure · Lagos</div>
        <p class="proj-desc">African startups were losing 7–12% of every cross-border payment to bank fees and FX markups. Zela needed to communicate a complex financial product with clarity and confidence — without looking like every other Lagos fintech.</p>
        <div class="proj-deliverables">
          <div class="pd-title">Deliverables</div>
          <div class="pd-tags">
            <span class="pd-tag">4-page product site</span>
            <span class="pd-tag">Transfer anatomy section</span>
            <span class="pd-tag">CSS mock UIs</span>
            <span class="pd-tag">GSAP animations</span>
            <span class="pd-tag">Pricing page</span>
            <span class="pd-tag">About page</span>
            <span class="pd-tag">Off-white + navy + blue</span>
          </div>
        </div>
        <div class="proj-actions">
          <a href="/contact" class="btn-gold">Build something similar</a>
        </div>
      </div>
      <div class="proj-visual reveal">
        <div class="pv-zela">
          <div class="pv-zela-bg">
            <svg viewBox="0 0 500 460" xmlns="http://www.w3.org/2000/svg" preserveAspectRatio="xMidYMid slice" width="100%" height="100%">
              <line x1="60" y1="200" x2="220" y2="260" stroke="#3B82F6" stroke-width=".6" stroke-dasharray="5 9"/>
              <line x1="220" y1="260" x2="400" y2="210" stroke="#3B82F6" stroke-width=".6" stroke-dasharray="5 9"/>
              <line x1="60" y1="200" x2="310" y2="350" stroke="#3B82F6" stroke-width=".6" stroke-dasharray="5 9"/>
              <line x1="220" y1="260" x2="310" y2="350" stroke="#3B82F6" stroke-width=".6" stroke-dasharray="5 9"/>
              <circle cx="60" cy="200" r="5" fill="#F59E0B"/>
              <circle cx="220" cy="260" r="6" fill="#F59E0B"/>
              <circle cx="400" cy="210" r="5" fill="#F59E0B"/>
              <circle cx="310" cy="350" r="5" fill="#F59E0B"/>
            </svg>
          </div>
          <div class="pv-zela-content">
            <span class="pv-zela-tag">Fintech · Payments · 4 pages</span>
            <div class="pv-zela-name">Zela</div>
            <div class="pv-zela-sub">Send money across Africa like a local transfer</div>
            <div class="pv-pages">
              <span class="pv-page">Home</span>
              <span class="pv-page">Product</span>
              <span class="pv-page">Pricing</span>
              <span class="pv-page">About</span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- PROJECT 02: STACKR -->
  <div class="project">
    <div class="proj-inner">
      <div class="proj-text reveal">
        <span class="proj-tag">Case study 02</span>
        <h2>Stackr — <em>Newsletter monetisation</em></h2>
        <div class="proj-industry">Creator economy · SaaS · Lagos</div>
        <p class="proj-desc">African newsletter writers were giving away their best work for free — not by choice, but because the payment tools didn't work for their readers. Stackr needed to feel like a publication, not a fintech product.</p>
        <div class="proj-deliverables">
          <div class="pd-title">Deliverables</div>
          <div class="pd-tags">
            <span class="pd-tag">5-page product site</span>
            <span class="pd-tag">Interactive revenue calculator</span>
            <span class="pd-tag">Creator story profiles</span>
            <span class="pd-tag">CSS newsletter mockup</span>
            <span class="pd-tag">GSAP animations</span>
            <span class="pd-tag">Fraunces optical serif</span>
            <span class="pd-tag">Warm cream + amber palette</span>
          </div>
        </div>
        <div class="proj-actions">
          <a href="/contact" class="btn-gold">Build something similar</a>
        </div>
      </div>
      <div class="proj-visual reveal">
        <div class="pv-stackr">
          <div class="pv-stackr-blob"></div>
          <div class="pv-stackr-content">
            <span class="pv-stackr-tag">Creator platform · Newsletter · 5 pages</span>
            <div class="pv-stackr-name">Stackr.</div>
            <div class="pv-stackr-sub">Africa's home for paid newsletters</div>
            <div class="pv-pages">
              <span class="pv-page-s">Home</span>
              <span class="pv-page-s">Product</span>
              <span class="pv-page-s">Pricing</span>
              <span class="pv-page-s">Stories</span>
              <span class="pv-page-s">About</span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- PROJECT 03: ROSTR -->
  <div class="project">
    <div class="proj-inner">
      <div class="proj-text reveal">
        <span class="proj-tag">Case study 03</span>
        <h2>Rostr — <em>Employer of Record</em></h2>
        <div class="proj-industry">HR tech · Future of work · Lagos</div>
        <p class="proj-desc">Global companies wanted to hire Nigerian engineers but faced months of compliance headaches. Rostr needed to feel immediately trustworthy — clean, corporate-light, laser-focused on one promise: we handle everything.</p>
        <div class="proj-deliverables">
          <div class="pd-title">Deliverables</div>
          <div class="pd-tags">
            <span class="pd-tag">Single-page product site</span>
            <span class="pd-tag">Hiring pipeline CSS mockup</span>
            <span class="pd-tag">4-step onboarding timeline</span>
            <span class="pd-tag">GSAP pipeline animation</span>
            <span class="pd-tag">Plus Jakarta Sans</span>
            <span class="pd-tag">White + coral palette</span>
          </div>
        </div>
        <div class="proj-actions">
          <a href="/contact" class="btn-gold">Build something similar</a>
        </div>
      </div>
      <div class="proj-visual reveal">
        <div class="pv-rostr">
          <div class="pv-rostr-grid"></div>
          <div class="pv-rostr-content">
            <span class="pv-rostr-tag">HR tech · EOR · Single page</span>
            <div class="pv-rostr-name">Rostr.</div>
            <div class="pv-rostr-sub">The easiest way to hire Nigerian talent, legally</div>
            <div class="pv-pages">
              <span class="pv-page-r">Landing page</span>
              <span class="pv-page-r">Pricing</span>
              <span class="pv-page-r">FAQ</span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- CTA -->
  <section class="cta-sec" style="border-top:1px solid var(--br)">
    <div class="cta-inner">
      <h2 class="reveal">Your project<br /><em>could be next.</em></h2>
      <p class="reveal">Every project here started with a brief, a problem, and a founder who needed their product to look as good as it works.</p>
      <div class="cta-actions reveal">
        <a href="/contact" class="btn-gold">Start a project →</a>
        <a href="/services" class="btn-outline-light">See our services</a>
      </div>
    </div>
  </section>

  <Footer />
</Layout>

<style is:global>
.page-hero { padding: 10rem 3rem 5rem; border-bottom: 1px solid var(--br); }
.ph-inner { max-width: 1300px; margin: 0 auto; }
.ph-label { font-size: .72rem; letter-spacing: 2px; text-transform: uppercase; color: var(--gold); margin-bottom: 1.5rem; display: flex; align-items: center; gap: .75rem; }
.ph-line { width: 32px; height: 1px; background: var(--gold); }
.page-hero h1 { font-size: clamp(3.5rem, 7vw, 8rem); font-weight: 300; line-height: 1.04; letter-spacing: -2px; margin-bottom: 1.5rem; }
.page-hero h1 em { font-style: italic; color: var(--gold); }
.page-hero p { font-size: 1rem; color: var(--muted); max-width: 52ch; line-height: 1.75; }
.project { border-bottom: 1px solid var(--br); }
.project:nth-child(even) .proj-visual { order: -1; }
.proj-inner { max-width: 1300px; margin: 0 auto; padding: 7rem 3rem; display: grid; grid-template-columns: 1fr 1fr; gap: 5rem; align-items: center; }
.proj-tag { font-size: .65rem; letter-spacing: 2px; text-transform: uppercase; color: var(--gold); background: var(--gold-l); border: 1px solid var(--gold-b); padding: .2rem .75rem; border-radius: 3px; display: inline-block; margin-bottom: 1.5rem; }
.proj-text h2 { font-size: clamp(2.5rem, 4vw, 4.5rem); font-weight: 300; line-height: 1.08; letter-spacing: -1.5px; margin-bottom: 1rem; }
.proj-text h2 em { font-style: italic; color: var(--gold); }
.proj-industry { font-size: .72rem; letter-spacing: 1px; text-transform: uppercase; color: var(--muted); margin-bottom: 1.5rem; }
.proj-desc { font-size: .9rem; color: var(--muted); line-height: 1.75; margin-bottom: 2rem; max-width: 44ch; }
.proj-deliverables { margin-bottom: 2rem; }
.pd-title { font-size: .65rem; letter-spacing: 2px; text-transform: uppercase; color: var(--muted); margin-bottom: .75rem; }
.pd-tags { display: flex; flex-wrap: wrap; gap: .5rem; }
.pd-tag { font-size: .68rem; color: var(--muted); background: var(--s2); border: 1px solid var(--br); padding: .2rem .65rem; border-radius: 3px; }
.proj-actions { display: flex; gap: .75rem; flex-wrap: wrap; margin-top: 2rem; }
/* Visual cards */
.proj-visual { border-radius: var(--rl); overflow: hidden; min-height: 460px; display: flex; flex-direction: column; }
.pv-zela { background: #060E20; border: 1px solid rgba(37,99,235,.15); padding: 2.5rem; position: relative; overflow: hidden; min-height: 460px; display: flex; flex-direction: column; }
.pv-zela-bg { position: absolute; top: 0; left: 0; right: 0; bottom: 0; pointer-events: none; opacity: .25; }
.pv-zela-content { position: relative; z-index: 1; height: 100%; display: flex; flex-direction: column; }
.pv-zela-tag { font-size: .6rem; letter-spacing: 1.5px; text-transform: uppercase; color: #60A5FA; background: rgba(37,99,235,.12); padding: .2rem .65rem; border-radius: 3px; display: inline-block; margin-bottom: auto; }
.pv-zela-name { font-size: 5rem; font-weight: 900; color: #fff; letter-spacing: -3px; line-height: 1; margin: 2rem 0 .5rem; font-family: system-ui, sans-serif; }
.pv-zela-sub { font-size: .72rem; color: #334155; margin-bottom: 1.25rem; }
.pv-pages { display: flex; gap: .4rem; flex-wrap: wrap; }
.pv-page { font-size: .6rem; color: #1E3A5F; background: rgba(37,99,235,.06); border: 1px solid rgba(37,99,235,.12); padding: .2rem .5rem; border-radius: 3px; }
.pv-stackr { background: #FAFAF5; border: 1px solid #E2DDD3; padding: 2.5rem; position: relative; overflow: hidden; min-height: 460px; display: flex; flex-direction: column; }
.pv-stackr-blob { position: absolute; top: -10%; right: -10%; width: 280px; height: 280px; background: radial-gradient(circle, rgba(232,149,42,.12) 0%, transparent 70%); border-radius: 50%; pointer-events: none; }
.pv-stackr-content { position: relative; z-index: 1; height: 100%; display: flex; flex-direction: column; }
.pv-stackr-tag { font-size: .6rem; font-weight: 600; letter-spacing: 1.5px; text-transform: uppercase; color: #E8952A; background: rgba(232,149,42,.1); padding: .2rem .65rem; border-radius: 3px; display: inline-block; margin-bottom: auto; }
.pv-stackr-name { font-family: 'Georgia', serif; font-size: 5rem; font-weight: 700; color: #0F0E0C; letter-spacing: -2px; line-height: 1; margin: 2rem 0 .5rem; }
.pv-stackr-sub { font-size: .72rem; color: #9A9289; margin-bottom: 1.25rem; }
.pv-page-s { font-size: .6rem; color: #9A9289; background: #F0EDE4; border: 1px solid #E2DDD3; padding: .2rem .5rem; border-radius: 3px; }
.pv-rostr { background: #F8F6F3; border: 1px solid #E4E0D8; padding: 2.5rem; position: relative; overflow: hidden; min-height: 460px; display: flex; flex-direction: column; }
.pv-rostr-grid { position: absolute; top: 0; left: 0; right: 0; bottom: 0; background-image: linear-gradient(rgba(13,27,42,.04) 1px, transparent 1px), linear-gradient(90deg, rgba(13,27,42,.04) 1px, transparent 1px); background-size: 28px 28px; pointer-events: none; }
.pv-rostr-content { position: relative; z-index: 1; height: 100%; display: flex; flex-direction: column; }
.pv-rostr-tag { font-size: .6rem; font-weight: 600; letter-spacing: 1.5px; text-transform: uppercase; color: #FF6B4A; background: rgba(255,107,74,.08); padding: .2rem .65rem; border-radius: 3px; display: inline-block; margin-bottom: auto; }
.pv-rostr-name { font-size: 5rem; font-weight: 900; color: #0D1B2A; letter-spacing: -3px; line-height: 1; margin: 2rem 0 .5rem; font-family: system-ui, sans-serif; }
.pv-rostr-sub { font-size: .72rem; color: #B0BAC6; margin-bottom: 1.25rem; }
.pv-page-r { font-size: .6rem; color: #B0BAC6; background: #F0EDE8; border: 1px solid #E4E0D8; padding: .2rem .5rem; border-radius: 3px; }
.cta-sec { padding: 8rem 3rem; text-align: center; position: relative; overflow: hidden; }
.cta-inner { max-width: 700px; margin: 0 auto; position: relative; z-index: 1; }
.cta-sec h2 { font-size: clamp(3rem, 5.5vw, 6rem); font-weight: 300; letter-spacing: -2px; line-height: 1.06; margin-bottom: 1.25rem; }
.cta-sec h2 em { font-style: italic; color: var(--gold); }
.cta-sec p { color: var(--muted); font-size: 1rem; max-width: 44ch; margin: 0 auto 2.5rem; line-height: 1.75; }
.cta-actions { display: flex; gap: 1rem; justify-content: center; flex-wrap: wrap; }
@media (max-width: 900px) {
  .page-hero { padding: 8rem 1.5rem 4rem; }
  .proj-inner { grid-template-columns: 1fr; gap: 2.5rem; padding: 5rem 1.5rem; }
  .project:nth-child(even) .proj-visual { order: 0; }
  .cta-sec { padding: 5rem 1.5rem; }
}
</style>

<script>
import gsap from 'gsap';
import { ScrollTrigger } from 'gsap/ScrollTrigger';
gsap.registerPlugin(ScrollTrigger);

gsap.timeline({ delay: 0.25 })
  .from('#phl', { opacity: 0, x: -16, duration: 0.5, ease: 'power2.out' })
  .from('#phh', { opacity: 0, y: 32, duration: 0.85, ease: 'power3.out' }, '-=.2')
  .from('#php', { opacity: 0, y: 20, duration: 0.6, ease: 'power2.out' }, '-=.4');

gsap.utils.toArray('.reveal').forEach((el: any, i: number) => {
  gsap.fromTo(el, { opacity: 0, y: 24 }, {
    opacity: 1, y: 0, duration: 0.7, ease: 'power2.out',
    delay: (i % 2) * 0.1,
    scrollTrigger: { trigger: el, start: 'top 87%', toggleActions: 'play none none none' }
  });
});
</script>
