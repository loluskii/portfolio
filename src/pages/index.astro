<script>
import gsap from 'gsap';
import { ScrollTrigger } from 'gsap/ScrollTrigger';
gsap.registerPlugin(ScrollTrigger);

// Hero entrance
gsap.timeline({ delay: 0.2 })
  .to('#htag', { opacity: 1, x: 0, duration: 0.6, ease: 'power2.out', from: { opacity: 0, x: -16 } })
  .from('#hh1', { opacity: 0, y: 40, duration: 1, ease: 'power3.out' }, '-=.3');

// Scroll reveals
gsap.utils.toArray('.reveal').forEach((el: any, i: number) => {
  gsap.fromTo(el, { opacity: 0, y: 24 }, {
    opacity: 1, y: 0, duration: 0.7, ease: 'power2.out',
    delay: (i % 3) * 0.08,
    scrollTrigger: { trigger: el, start: 'top 87%', toggleActions: 'play none none none' }
  });
});

// Service card stagger
gsap.utils.toArray('.svc-card').forEach((card: any, i: number) => {
  gsap.fromTo(card, { opacity: 0, y: 28 }, {
    opacity: 1, y: 0, duration: 0.6, ease: 'power2.out', delay: i * 0.12,
    scrollTrigger: { trigger: '.svc-cards', start: 'top 80%', once: true }
  });
});

// Work cards stagger
gsap.utils.toArray('.work-grid > *').forEach((card: any, i: number) => {
  gsap.fromTo(card, { opacity: 0, y: 32 }, {
    opacity: 1, y: 0, duration: 0.7, ease: 'power2.out', delay: i * 0.12,
    scrollTrigger: { trigger: '.work-grid', start: 'top 80%', once: true }
  });
});
</script>
