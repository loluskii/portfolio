---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
---

<Layout title="Design & Engineering Studio">
  <Nav activePage="home" />

  <!-- ── HERO ──────────────────────────────── -->
  <section class="hero">
    <div class="hero-line">
      <svg viewBox="0 0 1440 900" preserveAspectRatio="xMidYMid slice" xmlns="http://www.w3.org/2000/svg">
        <line x1="0" y1="300" x2="1440" y2="300" stroke="#C8A45A" stroke-width=".5"/>
        <line x1="0" y1="600" x2="1440" y2="600" stroke="#C8A45A" stroke-width=".5"/>
        <line x1="480" y1="0" x2="480" y2="900" stroke="#C8A45A" stroke-width=".5"/>
        <line x1="960" y1="0" x2="960" y2="900" stroke="#C8A45A" stroke-width=".5"/>
      </svg>
    </div>
    <div class="hero-content">
      <div class="hero-tag" id="htag">
        <span class="htag-line"></span>Design · Engineering · Brand
      </div>
      <h1 id="hh1">
        We create<br />digital products<br />that <em>earn their place.</em>
      </h1>
      <div class="hero-bottom" id="hbottom">
        <p class="hero-desc">
          A full-service design and engineering studio. Branding, product design,
          and software development — delivered as one, built to last.
        </p>
        <div class="hero-actions">
          <a href="/work" class="btn-outline-light">See our work</a>
          <a href="/contact" class="btn-gold">Start a project →</a>
        </div>
      </div>
    </div>
  </section>

  <!-- ── MARQUEE ────────────────────────────── -->
  <div class="marquee-wrap">
    <div class="marquee-inner">
      <span class="marquee-item">Branding</span><span class="marquee-dot">◆</span>
      <span class="marquee-item">Product Design</span><span class="marquee-dot">◆</span>
      <span class="marquee-item">Web Development</span><span class="marquee-dot">◆</span>
      <span class="marquee-item">MVP Build</span><span class="marquee-dot">◆</span>
      <span class="marquee-item">UI/UX Design</span><span class="marquee-dot">◆</span>
      <span class="marquee-item">Motion & Animation</span><span class="marquee-dot">◆</span>
      <span class="marquee-item">Design Systems</span><span class="marquee-dot">◆</span>
      <span class="marquee-item">Visual Identity</span><span class="marquee-dot">◆</span>
      <!-- Duplicated for seamless loop -->
      <span class="marquee-item">Branding</span><span class="marquee-dot">◆</span>
      <span class="marquee-item">Product Design</span><span class="marquee-dot">◆</span>
      <span class="marquee-item">Web Development</span><span class="marquee-dot">◆</span>
      <span class="marquee-item">MVP Build</span><span class="marquee-dot">◆</span>
      <span class="marquee-item">UI/UX Design</span><span class="marquee-dot">◆</span>
      <span class="marquee-item">Motion & Animation</span><span class="marquee-dot">◆</span>
      <span class="marquee-item">Design Systems</span><span class="marquee-dot">◆</span>
      <span class="marquee-item">Visual Identity</span><span class="marquee-dot">◆</span>
    </div>
  </div>

  <!-- ── MANIFESTO ──────────────────────────── -->
  <section class="manifesto">
    <div class="manifesto-inner">
      <div class="manifesto-text reveal">
        "Design without engineering is decoration.<br />Engineering without design is infrastructure.<br /><em>We do both — and we do them well.</em>"
      </div>
      <div class="manifesto-attr reveal">— The studio's point of view</div>
    </div>
  </section>

  <!-- ── SERVICES ───────────────────────────── -->
  <section class="services-sec">
    <div class="services-inner">
      <div class="sec-header reveal">
        <h2 class="sec-label">What we <em>do</em></h2>
      </div>

      <!-- 3 featured service cards -->
      <div class="svc-cards">
        <div class="svc-card reveal">
          <div class="sc-num">01</div>
          <div class="sc-bg-el">72h</div>
          <span class="sc-tag">Most popular</span>
          <h3 class="sc-name">Launch Package</h3>
          <p class="sc-pitch">High-converting landing pages and product sites. Live, polished, and ready — in 72 hours flat, guaranteed.</p>
          <div class="sc-footer">
            <div class="sc-price">₦150k <span>starting from</span></div>
            <span class="sc-time">72 hours</span>
          </div>
        </div>
        <div class="svc-card reveal">
          <div class="sc-num">02</div>
          <div class="sc-bg-el">&lt;/&gt;</div>
          <span class="sc-tag">Full product</span>
          <h3 class="sc-name">Build Package</h3>
          <p class="sc-pitch">Full MVP from zero — design, architecture, and code as one integrated engagement. Shipped and documented.</p>
          <div class="sc-footer">
            <div class="sc-price">₦800k <span>starting from</span></div>
            <span class="sc-time">4–12 weeks</span>
          </div>
        </div>
        <div class="svc-card reveal">
          <div class="sc-num">03</div>
          <div class="sc-bg-el">◆</div>
          <span class="sc-tag">Foundation first</span>
          <h3 class="sc-name">Brand & Identity</h3>
          <p class="sc-pitch">The visual language your product speaks. Logo, type, colour, motion — built to hold up at every scale.</p>
          <div class="sc-footer">
            <div class="sc-price">₦300k <span>starting from</span></div>
            <span class="sc-time">2–4 weeks</span>
          </div>
        </div>
      </div>

      <!-- 2 secondary services -->
      <div class="svc-secondary">
        <div class="svc-sec-item reveal">
          <div class="ssi-num">04</div>
          <div class="ssi-body">
            <div class="ssi-name">UI/UX Design</div>
            <div class="ssi-desc">Product design, wireframes, prototypes, and full design systems — interfaces that earn trust.</div>
          </div>
          <div class="ssi-price">From ₦250k</div>
        </div>
        <div class="svc-sec-item reveal">
          <div class="ssi-num">05</div>
          <div class="ssi-body">
            <div class="ssi-name">Graphics & Creative</div>
            <div class="ssi-desc">Pitch decks, social assets, and collateral — the visual language for everything that isn't the product.</div>
          </div>
          <div class="ssi-price">From ₦80k</div>
        </div>
      </div>

      <div class="svc-cta-row reveal">
        <a href="/services" class="btn-svc-all">
          <em>See all services in detail</em>
          <span class="bsa-arrow">→</span>
        </a>
      </div>
    </div>
  </section>

  <!-- ── WORK ────────────────────────────────── -->
  <section class="work-sec">
    <div class="work-inner">
      <div class="sec-header reveal">
        <h2 class="sec-label">Selected work</h2>
        <a href="/work" class="sec-link">All projects →</a>
      </div>
      <div class="work-grid reveal">
        <!-- Zela -->
        <div class="wcard-zela">
          <div class="wc-bg">
            <svg viewBox="0 0 400 400" xmlns="http://www.w3.org/2000/svg" preserveAspectRatio="xMidYMid slice" width="100%" height="100%">
              <line x1="60" y1="200" x2="220" y2="260" stroke="#3B82F6" stroke-width=".6" stroke-dasharray="5 9"/>
              <line x1="220" y1="260" x2="400" y2="210" stroke="#3B82F6" stroke-width=".6" stroke-dasharray="5 9"/>
              <line x1="60" y1="200" x2="310" y2="350" stroke="#3B82F6" stroke-width=".6" stroke-dasharray="5 9"/>
              <circle cx="60" cy="200" r="5" fill="#F59E0B"/>
              <circle cx="220" cy="260" r="6" fill="#F59E0B"/>
              <circle cx="400" cy="210" r="5" fill="#F59E0B"/>
              <circle cx="310" cy="350" r="5" fill="#F59E0B"/>
            </svg>
          </div>
          <div class="wc-content">
            <span class="wc-tag">Fintech · 4-page site</span>
            <div style="font-size:3.5rem;font-weight:900;color:#fff;letter-spacing:-2px;line-height:1;margin:2rem 0 .5rem;font-family:system-ui,sans-serif">Zela</div>
            <div class="wc-info">African cross-border payments infrastructure<br/>GSAP animations · CSS mock UIs</div>
            <a href="/work" class="wc-link">View case study →</a>
          </div>
        </div>
        <!-- Stackr -->
        <div class="wcard-stackr">
          <div class="wc-content">
            <span class="wc-tag-stackr">Creator platform · 5-page site</span>
            <div style="font-family:'Georgia',serif;font-size:3.5rem;font-weight:700;color:#0F0E0C;letter-spacing:-1px;line-height:1;margin:2rem 0 .5rem">Stackr.</div>
            <div class="wc-info-stackr">African newsletter monetisation platform<br/>Fraunces serif · Revenue calculator</div>
            <a href="/work" class="wc-link-stackr">View case study →</a>
          </div>
        </div>
        <!-- Rostr -->
        <div class="wcard-rostr">
          <div class="wc-content">
            <span class="wc-tag-rostr">HR tech · Single-page site</span>
            <div style="font-size:3.5rem;font-weight:900;color:#0D1B2A;letter-spacing:-3px;line-height:1;margin:2rem 0 .5rem;font-family:system-ui,sans-serif">Rostr.</div>
            <div class="wc-info-rostr">Employer of Record for Nigerian talent<br/>Hiring pipeline mockup</div>
            <a href="/work" class="wc-link-rostr">View case study →</a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ── PROCESS ─────────────────────────────── -->
  <section class="process-sec">
    <div class="process-inner">
      <div class="sec-header reveal">
        <h2 class="sec-label">How we work</h2>
      </div>
      <div class="process-grid">
        <div class="process-step reveal">
          <div class="ps-num">01</div>
          <div class="ps-name">Discovery</div>
          <p class="ps-desc">We start by understanding the problem — not just the brief. One focused session. What you're building, who it's for, and what success looks like.</p>
        </div>
        <div class="process-step reveal">
          <div class="ps-num">02</div>
          <div class="ps-name">Strategy</div>
          <p class="ps-desc">Before a pixel is placed, we define the positioning. Brand direction, product architecture, and the design language that will carry everything else.</p>
        </div>
        <div class="process-step reveal">
          <div class="ps-num">03</div>
          <div class="ps-name">Execution</div>
          <p class="ps-desc">Design and engineering in parallel — not in sequence. Faster delivery, tighter output. You see progress from day one, not week three.</p>
        </div>
        <div class="process-step reveal">
          <div class="ps-num">04</div>
          <div class="ps-name">Delivery</div>
          <p class="ps-desc">Production-ready. Tested. Documented. Handed over with everything you need to maintain, grow, and iterate — not just a set of files.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- ── CTA ────────────────────────────────── -->
  <section class="cta-sec">
    <div class="cta-bg-text">Studio</div>
    <div class="cta-inner">
      <div class="cta-label reveal">
        <span style="width:32px;height:1px;background:var(--gold);display:inline-block"></span>
        Ready to build
        <span style="width:32px;height:1px;background:var(--gold);display:inline-block"></span>
      </div>
      <h2 class="reveal">Let's make<br />something <em>great.</em></h2>
      <p class="reveal">Tell us what you're building. We'll tell you how we'd approach it — honestly, and without a sales pitch.</p>
      <div class="cta-actions reveal">
        <a href="/contact" class="btn-gold">Start a project →</a>
        <a href="/work" class="btn-outline-light">See our work</a>
      </div>
    </div>
  </section>

  <Footer />
</Layout>

<style is:global>
/* ── HERO ────────────────────────────────── */
.hero {
  min-height: 100vh; display: flex; flex-direction: column;
  justify-content: flex-end; padding: 0 3rem 5rem;
  position: relative; overflow: hidden;
}
.hero-line { position: absolute; top: 0; left: 0; right: 0; bottom: 0; pointer-events: none; }
.hero-line svg { width: 100%; height: 100%; opacity: .04; }
.hero-content { position: relative; z-index: 1; max-width: 1300px; width: 100%; }
.hero-tag {
  font-size: .72rem; font-weight: 500; letter-spacing: 2px;
  text-transform: uppercase; color: var(--gold);
  margin-bottom: 2rem; display: flex; align-items: center;
  gap: .75rem; opacity: 0;
}
.htag-line { width: 32px; height: 1px; background: var(--gold); }
.hero h1 {
  font-size: clamp(4rem, 9vw, 11rem); font-weight: 300;
  line-height: 1; letter-spacing: -2px; color: var(--text); margin-bottom: 3rem;
}
.hero h1 em { font-style: italic; color: var(--gold); }
.hero-bottom {
  display: grid; grid-template-columns: 1fr 1fr; gap: 3rem;
  align-items: end; border-top: 1px solid var(--br); padding-top: 2rem;
}
.hero-desc { font-size: 1rem; color: var(--muted); line-height: 1.75; max-width: 42ch; }
.hero-actions { display: flex; gap: 1rem; justify-content: flex-end; flex-wrap: wrap; }

/* ── MANIFESTO ──────────────────────────── */
.manifesto { padding: 8rem 3rem; border-bottom: 1px solid var(--br); }
.manifesto-inner { max-width: 1300px; margin: 0 auto; }
.manifesto-text {
  font-family: 'Cormorant Garamond', serif;
  font-size: clamp(2rem, 4vw, 4.5rem); font-weight: 300;
  font-style: italic; line-height: 1.3; color: var(--text); max-width: 22ch;
}
.manifesto-text em { font-style: normal; color: var(--gold); }
.manifesto-attr {
  font-size: .72rem; letter-spacing: 2px; text-transform: uppercase;
  color: var(--muted); margin-top: 2rem;
}

/* ── SERVICES ───────────────────────────── */
.services-sec { padding: 7rem 3rem; border-bottom: 1px solid var(--br); background: var(--s1); }
.services-inner { max-width: 1300px; margin: 0 auto; }
.sec-header { display: flex; align-items: baseline; justify-content: space-between; margin-bottom: 3.5rem; gap: 2rem; }
.sec-link {
  font-size: .72rem; letter-spacing: 1.5px; text-transform: uppercase;
  color: var(--muted); display: flex; align-items: center; gap: .5rem; transition: color .2s;
}
.sec-link:hover { color: var(--gold); }
.svc-cards {
  display: grid; grid-template-columns: repeat(3, 1fr);
  gap: 1px; background: var(--br); margin-bottom: 1px;
}
.svc-card {
  background: var(--bg); padding: 2.5rem; position: relative;
  overflow: hidden; transition: background .3s; cursor: default;
  display: flex; flex-direction: column; min-height: 320px;
}
.svc-card:hover { background: var(--s2); }
.svc-card:hover .sc-name { color: var(--gold); }
.sc-num {
  font-family: 'Cormorant Garamond', serif; font-size: 8rem; font-weight: 300;
  color: var(--text); opacity: .04; position: absolute; top: 1rem; right: 1.5rem;
  line-height: 1; letter-spacing: -4px; pointer-events: none; user-select: none;
}
.sc-bg-el {
  position: absolute; bottom: 1.5rem; right: 2rem;
  font-family: 'Cormorant Garamond', serif; font-size: 3.5rem;
  font-weight: 300; color: var(--text); opacity: .03; line-height: 1;
  pointer-events: none; user-select: none; transition: opacity .3s;
}
.svc-card:hover .sc-bg-el { opacity: .07; }
.sc-tag {
  font-size: .6rem; font-weight: 500; letter-spacing: 2px; text-transform: uppercase;
  color: var(--gold); background: var(--gold-l); border: 1px solid var(--gold-b);
  padding: .2rem .65rem; border-radius: 3px; display: inline-block; margin-bottom: auto;
}
.sc-name {
  font-family: 'Cormorant Garamond', serif;
  font-size: clamp(1.75rem, 2.5vw, 2.25rem); font-weight: 300;
  color: var(--text); margin-top: 2rem; margin-bottom: .75rem;
  line-height: 1.2; transition: color .3s;
}
.sc-pitch { font-size: .82rem; color: var(--muted); line-height: 1.65; max-width: 28ch; flex: 1; margin-bottom: 2rem; }
.sc-footer {
  display: flex; align-items: center; justify-content: space-between;
  border-top: 1px solid var(--br); padding-top: 1.25rem; margin-top: auto;
}
.sc-price {
  font-family: 'Cormorant Garamond', serif;
  font-size: 1.35rem; font-weight: 300; color: var(--text); letter-spacing: -.5px;
}
.sc-price span {
  font-size: .65rem; font-family: 'Inter', sans-serif;
  font-weight: 400; color: var(--muted); letter-spacing: 0; margin-left: .2rem;
}
.sc-time {
  font-size: .6rem; font-weight: 500; letter-spacing: 1px; text-transform: uppercase;
  color: var(--gold); background: var(--gold-l); border: 1px solid var(--gold-b);
  padding: .15rem .55rem; border-radius: 3px;
}
.svc-secondary {
  display: grid; grid-template-columns: 1fr 1fr;
  gap: 1px; background: var(--br); margin-bottom: 3rem;
}
.svc-sec-item {
  background: var(--bg); padding: 1.75rem 2rem;
  display: flex; align-items: center; gap: 2rem; transition: background .2s;
}
.svc-sec-item:hover { background: var(--s2); }
.svc-sec-item:hover .ssi-name { color: var(--gold); }
.ssi-num {
  font-family: 'Cormorant Garamond', serif; font-size: 1.5rem;
  font-weight: 300; color: var(--dim); flex-shrink: 0; width: 2.5rem;
}
.ssi-body { flex: 1; }
.ssi-name {
  font-family: 'Cormorant Garamond', serif; font-size: 1.2rem;
  font-weight: 300; color: var(--text); margin-bottom: .25rem; transition: color .2s;
}
.ssi-desc { font-size: .78rem; color: var(--muted); line-height: 1.5; }
.ssi-price { font-size: .8rem; color: var(--muted); flex-shrink: 0; text-align: right; white-space: nowrap; }
.svc-cta-row { text-align: center; }
.btn-svc-all {
  font-family: 'Cormorant Garamond', serif; font-weight: 400; font-size: 1.25rem;
  color: var(--text); border: 1px solid var(--br); padding: 1rem 3rem;
  border-radius: 3px; display: inline-flex; align-items: center; gap: .85rem; transition: all .3s;
}
.btn-svc-all:hover { border-color: var(--gold-b); color: var(--gold); }
.bsa-arrow {
  font-style: normal; font-size: .75rem; letter-spacing: 1px;
  text-transform: uppercase; font-family: 'Inter', sans-serif;
  color: var(--muted); transition: color .3s; font-weight: 500;
}
.btn-svc-all:hover .bsa-arrow { color: var(--gold); }

/* ── WORK ───────────────────────────────── */
.work-sec { padding: 7rem 3rem; border-bottom: 1px solid var(--br); }
.work-inner { max-width: 1300px; margin: 0 auto; }
.work-grid {
  display: grid; grid-template-columns: repeat(3, 1fr);
  gap: 1px; background: var(--br); margin-top: 4rem; border: 1px solid var(--br);
}
.wcard-zela {
  background: #060E20; padding: 2.5rem; display: flex; flex-direction: column;
  min-height: 400px; position: relative; overflow: hidden; transition: filter .3s;
}
.wcard-zela:hover { filter: brightness(1.15); }
.wc-bg { position: absolute; top: 0; left: 0; right: 0; bottom: 0; pointer-events: none; opacity: .15; }
.wc-bg svg { width: 100%; height: 100%; }
.wc-content { position: relative; z-index: 1; display: flex; flex-direction: column; height: 100%; }
.wc-tag {
  font-size: .62rem; font-weight: 500; letter-spacing: 1.5px; text-transform: uppercase;
  color: #60A5FA; background: rgba(37,99,235,.1); padding: .2rem .65rem; border-radius: 3px;
  display: inline-block; margin-bottom: auto;
}
.wc-info { font-size: .7rem; color: #334155; margin-bottom: 1.5rem; line-height: 1.5; }
.wc-link {
  font-size: .72rem; font-weight: 600; letter-spacing: 1px; text-transform: uppercase;
  color: #60A5FA; display: flex; align-items: center; gap: .4rem; transition: gap .2s;
}
.wc-link:hover { gap: .7rem; }
.wcard-stackr {
  background: #FAFAF5; padding: 2.5rem; display: flex; flex-direction: column;
  min-height: 400px; position: relative; overflow: hidden; transition: filter .3s;
}
.wcard-stackr:hover { filter: brightness(.97); }
.wc-tag-stackr {
  font-size: .62rem; font-weight: 600; letter-spacing: 1.5px; text-transform: uppercase;
  color: #E8952A; background: rgba(232,149,42,.1); padding: .2rem .65rem; border-radius: 3px;
  display: inline-block; margin-bottom: auto;
}
.wc-info-stackr { font-size: .7rem; color: #9A9289; margin-bottom: 1.5rem; line-height: 1.5; }
.wc-link-stackr {
  font-size: .72rem; font-weight: 600; letter-spacing: 1px; text-transform: uppercase;
  color: #E8952A; display: flex; align-items: center; gap: .4rem; transition: gap .2s;
}
.wc-link-stackr:hover { gap: .7rem; }
.wcard-rostr {
  background: #F8F6F3; padding: 2.5rem; display: flex; flex-direction: column;
  min-height: 400px; position: relative; overflow: hidden; transition: filter .3s;
}
.wcard-rostr:hover { filter: brightness(.97); }
.wc-tag-rostr {
  font-size: .62rem; font-weight: 600; letter-spacing: 1.5px; text-transform: uppercase;
  color: #FF6B4A; background: rgba(255,107,74,.08); padding: .2rem .65rem; border-radius: 3px;
  display: inline-block; margin-bottom: auto;
}
.wc-info-rostr { font-size: .7rem; color: #B0BAC6; margin-bottom: 1.5rem; line-height: 1.5; }
.wc-link-rostr {
  font-size: .72rem; font-weight: 600; letter-spacing: 1px; text-transform: uppercase;
  color: #FF6B4A; display: flex; align-items: center; gap: .4rem; transition: gap .2s;
}
.wc-link-rostr:hover { gap: .7rem; }

/* ── PROCESS ────────────────────────────── */
.process-sec { padding: 7rem 3rem; border-bottom: 1px solid var(--br); background: var(--s1); }
.process-inner { max-width: 1300px; margin: 0 auto; }
.process-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 3rem; margin-top: 4rem; }
.process-step { border-top: 1px solid var(--br); padding-top: 1.75rem; }
.ps-num {
  font-family: 'Cormorant Garamond', serif; font-size: 4rem; font-weight: 300;
  color: var(--dim); line-height: 1; margin-bottom: 1.25rem; letter-spacing: -2px;
}
.ps-name { font-family: 'Cormorant Garamond', serif; font-size: 1.35rem; font-weight: 400; color: var(--text); margin-bottom: .6rem; }
.ps-desc { font-size: .82rem; color: var(--muted); line-height: 1.65; }

/* ── CTA ────────────────────────────────── */
.cta-sec { padding: 10rem 3rem; text-align: center; position: relative; overflow: hidden; }
.cta-bg-text {
  position: absolute; top: 50%; left: 50%; transform: translate(-50%, -50%);
  font-family: 'Cormorant Garamond', serif; font-size: 20vw; font-weight: 300;
  color: rgba(255,255,255,.02); white-space: nowrap; pointer-events: none; letter-spacing: -5px;
}
