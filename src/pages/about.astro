---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
---

<Layout title="About">
  <Nav activePage="about" />

  <!-- HERO -->
  <section class="about-hero">
    <div class="ah-inner">
      <div class="ah-left">
        <div class="ah-eyebrow" id="aey"><span class="ah-line"></span>The studio</div>
        <h1 id="ah1">We build things<br />that <em>deserve</em><br />to exist.</h1>
      </div>
      <div class="ah-right" id="aright">
        <div class="ah-pull">"Most software looks like it was built by engineers for engineers. We build software that looks like it was built for the person who has to use it every day."</div>
        <p class="ah-sub">A design and engineering studio based in Lagos, Nigeria. We work with founders, startups, and growth-stage companies across Africa and beyond — building the products, brands, and experiences they need to compete.</p>
      </div>
    </div>
  </section>

  <!-- WHAT WE ARE -->
  <section class="what-sec">
    <div class="what-inner">
      <div class="what-sticky reveal">
        <div class="what-label">What we are</div>
        <h2 class="what-h">One studio.<br /><em>Every layer.</em></h2>
      </div>
      <div class="what-body">
        <p class="lead reveal">We are a full-service design and engineering studio. That means brand, product, and code — not as separate handoffs between different teams, but as one integrated process delivered by people who understand all three.</p>
        <p class="reveal">Most agencies specialise. A branding agency hands you a logo and wishes you luck. A development shop takes a brief and builds what they're told. The result is a product that looks designed but doesn't work, or works but doesn't convert.</p>
        <div class="what-pull reveal">
          <p>"When design and engineering share a brain, products are different. They feel inevitable — like they couldn't have been built any other way."</p>
        </div>
        <p class="reveal">We close that gap by design. Every project gets the same thinking applied across every layer — from the brand positioning that informs the visual identity, to the component architecture that makes the interface effortless, to the copy that makes a visitor understand in three seconds what the product is.</p>
        <p class="reveal">We are a small studio. We work with a small number of clients at any given time. That is intentional — because the work requires genuine attention, and genuine attention does not scale infinitely.</p>
      </div>
    </div>
  </section>

  <!-- VALUES -->
  <section class="values-sec">
    <div class="values-inner">
      <div class="reveal">
        <h2 class="values-h">Four things we<br /><em>won't compromise on.</em></h2>
      </div>
      <div class="values-grid">
        <div class="value-card reveal">
          <div class="vc-num">01</div>
          <div class="vc-name">Craft over <em>speed</em></div>
          <p class="vc-desc">We move fast — the 72-hour guarantee exists because we have built the systems to deliver quickly without cutting corners. But when speed and quality conflict, quality wins. Always.</p>
        </div>
        <div class="value-card reveal">
          <div class="vc-num">02</div>
          <div class="vc-name">Honest <em>pricing</em></div>
          <p class="vc-desc">We quote what the work costs and we do what we quote. No scope creep surprises, no "that wasn't included" conversations. Brief agreed upfront, price agreed upfront, then we build it.</p>
        </div>
        <div class="value-card reveal">
          <div class="vc-num">03</div>
          <div class="vc-name">Design as <em>thinking</em></div>
          <p class="vc-desc">We do not design from a mood board. We design from an understanding of the problem — who the user is, what they need to believe, and what needs to happen for them to take action.</p>
        </div>
        <div class="value-card reveal">
          <div class="vc-num">04</div>
          <div class="vc-name">Delivery that <em>actually delivers</em></div>
          <p class="vc-desc">The product is done when the client can maintain it, grow it, and iterate on it without us. We document everything and hand over work that is genuinely yours — not a black box.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- CAPABILITIES -->
  <section class="cap-sec">
    <div class="cap-inner">
      <div class="reveal">
        <h2 class="cap-h">What we're<br /><em>actually good at.</em></h2>
      </div>
      <div class="cap-grid">
        <div class="cap-item reveal"><span class="cap-icon">⚡</span><div class="cap-name">Frontend engineering</div><p class="cap-desc">React, Next.js, Astro, vanilla HTML/CSS. Built for performance, accessibility, and longevity.</p></div>
        <div class="cap-item reveal"><span class="cap-icon">🎨</span><div class="cap-name">Product design</div><p class="cap-desc">UI/UX design in Figma — from rough wireframe to production-ready component library.</p></div>
        <div class="cap-item reveal"><span class="cap-icon">◆</span><div class="cap-name">Brand & identity</div><p class="cap-desc">Visual identity systems built to scale. Logo, type, colour, motion — the full language.</p></div>
        <div class="cap-item reveal"><span class="cap-icon">📐</span><div class="cap-name">Design systems</div><p class="cap-desc">Component libraries, design tokens, and documentation that make scaling fast, not painful.</p></div>
        <div class="cap-item reveal"><span class="cap-icon">🚀</span><div class="cap-name">MVP development</div><p class="cap-desc">Full product builds from zero — architecture, design, development, and deployment.</p></div>
        <div class="cap-item reveal"><span class="cap-icon">📊</span><div class="cap-name">Creative production</div><p class="cap-desc">Pitch decks, social assets, marketing collateral — consistent across every surface.</p></div>
      </div>
    </div>
  </section>

  <!-- LOU TECHNOLOGIES -->
  <section class="lou-sec">
    <div class="lou-inner">
      <div class="lou-left reveal">
        <h2>Part of<br /><em>Lou Technologies.</em></h2>
        <p>The studio operates as a product of Lou Technologies — a registered technology company based in Lagos, Nigeria. Lou Technologies is the legal entity behind our client contracts, invoices, and company registration.</p>
      </div>
      <div class="lou-right reveal">
        <div class="lou-mark"></div>
        <div class="lou-name">Lou Technologies</div>
        <div class="lou-reg">Registered in Nigeria · Lagos</div>
        <p class="lou-desc">A technology company building digital products, studios, and tools for African businesses and beyond. The studio is Lou Technologies' flagship service offering — bringing design and engineering under one roof.</p>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="cta-sec">
    <div class="cta-inner">
      <h2 class="reveal">Ready to<br /><em>work together?</em></h2>
      <p class="reveal">Tell us what you're building. We'll tell you honestly whether we're the right fit — and if we are, exactly how we'd approach it.</p>
      <div class="cta-actions reveal">
        <a href="/contact" class="btn-gold">Start a project →</a>
      </div>
    </div>
  </section>

  <Footer />
</Layout>

<style is:global>
.about-hero { padding: 10rem 3rem 6rem; border-bottom: 1px solid var(--br); }
.ah-inner { max-width: 1300px; margin: 0 auto; display: grid; grid-template-columns: 1fr 1fr; gap: 6rem; align-items: end; }
.ah-eyebrow { font-size: .72rem; letter-spacing: 2px; text-transform: uppercase; color: var(--gold); margin-bottom: 1.5rem; display: flex; align-items: center; gap: .75rem; }
.ah-line { width: 32px; height: 1px; background: var(--gold); }
.ah-inner h1 { font-size: clamp(3rem, 6vw, 7rem); font-weight: 300; line-height: 1.04; letter-spacing: -2px; }
.ah-inner h1 em { font-style: italic; color: var(--gold); }
.ah-pull { font-family: 'Cormorant Garamond', serif; font-size: 1.2rem; font-weight: 300; font-style: italic; color: var(--text); line-height: 1.55; border-left: 1px solid var(--gold); padding-left: 1.5rem; margin-bottom: 1.75rem; }
.ah-sub { font-size: .9rem; color: var(--muted); line-height: 1.75; }
.what-sec { padding: 8rem 3rem; border-bottom: 1px solid var(--br); }
.what-inner { max-width: 1300px; margin: 0 auto; display: grid; grid-template-columns: 300px 1fr; gap: 7rem; }
.what-sticky { position: sticky; top: 8rem; align-self: start; }
.what-label { font-size: .72rem; letter-spacing: 2px; text-transform: uppercase; color: var(--gold); margin-bottom: 1.25rem; }
.what-h { font-size: clamp(2rem, 3vw, 3rem); font-weight: 300; line-height: 1.1; }
.what-h em { font-style: italic; color: var(--gold); }
.what-body { display: flex; flex-direction: column; gap: 1.75rem; }
.what-body p { font-size: 1rem; color: var(--muted); line-height: 1.85; }
.what-body p.lead { font-size: 1.1rem; color: var(--text); font-weight: 300; line-height: 1.7; }
.what-pull { border-left: 1px solid var(--gold-b); padding-left: 1.5rem; margin: .5rem 0; }
.what-pull p { font-family: 'Cormorant Garamond', serif; font-size: 1.35rem; font-weight: 300; font-style: italic; color: var(--text); line-height: 1.45; }
.values-sec { padding: 7rem 3rem; border-bottom: 1px solid var(--br); background: var(--s1); }
.values-inner { max-width: 1300px; margin: 0 auto; }
.values-h { font-size: clamp(2rem, 3.5vw, 3.5rem); font-weight: 300; margin-bottom: 4rem; line-height: 1.1; }
.values-h em { font-style: italic; color: var(--gold); }
.values-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 1px; background: var(--br); }
.value-card { background: var(--bg); padding: 3rem; transition: background .2s; }
.value-card:hover { background: var(--s2); }
.vc-num { font-family: 'Cormorant Garamond', serif; font-size: 3.5rem; font-weight: 300; color: var(--dim); line-height: 1; margin-bottom: 1.5rem; letter-spacing: -2px; }
.vc-name { font-family: 'Cormorant Garamond', serif; font-size: 1.75rem; font-weight: 300; color: var(--text); margin-bottom: .75rem; }
.vc-name em { font-style: italic; color: var(--gold); }
.vc-desc { font-size: .875rem; color: var(--muted); line-height: 1.7; }
.cap-sec { padding: 7rem 3rem; border-bottom: 1px solid var(--br); }
.cap-inner { max-width: 1300px; margin: 0 auto; }
.cap-h { font-size: clamp(2rem, 3.5vw, 3.5rem); font-weight: 300; margin-bottom: 4rem; line-height: 1.1; }
.cap-h em { font-style: italic; color: var(--gold); }
.cap-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 3rem; }
.cap-item { border-top: 1px solid var(--br); padding-top: 1.75rem; }
.cap-icon { font-size: 1.5rem; margin-bottom: 1rem; display: block; }
.cap-name { font-family: 'Cormorant Garamond', serif; font-size: 1.25rem; font-weight: 400; color: var(--text); margin-bottom: .5rem; }
.cap-desc { font-size: .82rem; color: var(--muted); line-height: 1.65; }
.lou-sec { padding: 6rem 3rem; border-bottom: 1px solid var(--br); background: var(--s1); }
.lou-inner { max-width: 1300px; margin: 0 auto; display: grid; grid-template-columns: 1fr 1fr; gap: 6rem; align-items: center; }
.lou-left h2 { font-size: clamp(2rem, 3.5vw, 3.5rem); font-weight: 300; line-height: 1.15; margin-bottom: 1rem; }
.lou-left h2 em { font-style: italic; color: var(--gold); }
.lou-left p { font-size: .9rem; color: var(--muted); line-height: 1.75; max-width: 42ch; }
.lou-right { background: var(--s2); border: 1px solid var(--br); border-radius: var(--rl); padding: 2.5rem; }
.lou-mark { width: 40px; height: 40px; border: 2px solid var(--gold); border-radius: 6px; transform: rotate(45deg); margin-bottom: 2rem; }
.lou-name { font-family: 'Cormorant Garamond', serif; font-size: 1.5rem; font-weight: 400; color: var(--text); margin-bottom: .5rem; letter-spacing: .5px; }
.lou-reg { font-size: .72rem; letter-spacing: 1px; text-transform: uppercase; color: var(--muted); margin-bottom: 1.5rem; }
.lou-desc { font-size: .85rem; color: var(--muted); line-height: 1.7; }
.cta-sec { padding: 8rem 3rem; text-align: center; }
.cta-inner { max-width: 700px; margin: 0 auto; }
.cta-sec h2 { font-size: clamp(3rem, 5.5vw, 6rem); font-weight: 300; letter-spacing: -2px; line-height: 1.06; margin-bottom: 1.25rem; }
.cta-sec h2 em { font-style: italic; color: var(--gold); }
.cta-sec p { color: var(--muted); font-size: 1rem; max-width: 44ch; margin: 0 auto 2.5rem; line-height: 1.75; }
.cta-actions { display: flex; gap: 1rem; justify-content: center; flex-wrap: wrap; }
@media (max-width: 900px) {
  .about-hero { padding: 8rem 1.5rem 5rem; }
  .ah-inner { grid-template-columns: 1fr; gap: 2.5rem; }
  .what-inner { grid-template-columns: 1fr; gap: 2.5rem; }
  .what-sticky { position: static; }
  .values-grid { grid-template-columns: 1fr; }
  .cap-grid { grid-template-columns: 1fr 1fr; }
  .lou-inner { grid-template-columns: 1fr; gap: 2.5rem; }
  .what-sec, .values-sec, .cap-sec, .lou-sec, .cta-sec { padding: 5rem 1.5rem; }
}
</style>

<script>
import gsap from 'gsap';
import { ScrollTrigger } from 'gsap/ScrollTrigger';
gsap.registerPlugin(ScrollTrigger);

gsap.timeline({ delay: 0.25 })
  .from('#aey', { opacity: 0, x: -16, duration: 0.5, ease: 'power2.out' })
  .from('#ah1', { opacity: 0, y: 32, duration: 0.85, ease: 'power3.out' }, '-=.2')
  .from('#aright', { opacity: 0, y: 24, duration: 0.7, ease: 'power2.out' }, '-=.5');

gsap.utils.toArray('.reveal').forEach((el: any, i: number) => {
  gsap.fromTo(el, { opacity: 0, y: 24 }, {
    opacity: 1, y: 0, duration: 0.7, ease: 'power2.out',
    delay: (i % 3) * 0.08,
    scrollTrigger: { trigger: el, start: 'top 87%', toggleActions: 'play none none none' }
  });
});
</script>
