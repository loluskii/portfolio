---
import { siteMeta } from '../data/portfolio';

const year = new Date().getFullYear();
---

<footer>
  <div class="shell footer-shell">
    <div class="footer-copy">
      <strong>{siteMeta.name}</strong>
      <span>
        {year} · {siteMeta.location} · Frontend-heavy, product-aware, full-stack when useful.
      </span>
    </div>

    <div class="footer-links">
      <a href={`mailto:${siteMeta.email}`}>Email</a>
      <a href={siteMeta.linkedin} target="_blank" rel="noreferrer">LinkedIn</a>
      <a href={siteMeta.github} target="_blank" rel="noreferrer">GitHub</a>
      <a href="/isaac-adelore-cv.pdf" target="_blank" rel="noreferrer">CV</a>
    </div>
  </div>
</footer>
