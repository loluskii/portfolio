---
const profileLinks = [
  { label: 'View Work', href: '#work' },
  { label: 'LinkedIn', href: 'https://linkedin.com/in/adeloreisaac', external: true },
  { label: 'Send Email', href: 'mailto:adeloreisaac@gmail.com' },
];
---

<section class="hero" id="hero">
  <div class="shell hero-inner">
    <div class="hero-top">
      <div class="hero-intro" data-intro="top">
        <div class="hero-avatar" aria-hidden="true">IA</div>
        <p class="hero-intro-copy">
          I build fast, resilient product interfaces across real-time platforms,
          dashboards, white-label systems, payments, and internal tooling.
        </p>
      </div>
    </div>

    <div class="hero-heading">
      <h1 class="hero-headline">
        <span class="line-wrap">
          <span class="line hero-headline-solid" data-line>Frontend Engineer</span>
        </span>
      </h1>
    </div>

    <div class="hero-meta" data-intro="body">
      <div class="hero-meta-segment">
        <span class="hero-meta-label">Lagos, NG</span>
        <span class="hero-meta-rule"></span>
      </div>
      <div class="hero-meta-segment">
        <span class="hero-meta-label">WAT (GMT +1)</span>
        <span class="hero-meta-rule"></span>
      </div>
      <div class="hero-availability">
        <span class="availability-dot"></span>
        Available
      </div>
    </div>

    <div class="hero-body">
      <div class="hero-copy" data-intro="body">
        <p class="hero-summary" data-summary-text>
          I help product teams ship interfaces that stay clear under live state,
          business rules, and delivery pressure. Across fintech, communication,
          internal tooling, and gaming, I turn messy surfaces into frontend systems
          that feel deliberate in production.
        </p>
        <div class="hero-actions">
          {profileLinks.map((link) => (
            <a
              href={link.href}
              class="hero-action"
              data-cursor-label={link.external ? 'Open' : 'View'}
              data-cursor-tone="accent"
              target={link.external ? '_blank' : undefined}
              rel={link.external ? 'noreferrer' : undefined}
            >
              {link.label}
              <span aria-hidden="true">↗</span>
            </a>
          ))}
        </div>
      </div>

      <div class="hero-portrait-shell" data-intro="body">
        <div class="hero-portrait" data-parallax="portrait">
          <div class="hero-portrait-note">Product systems / delivery / ownership</div>
          <div class="portrait-figure" aria-hidden="true">
            <span class="figure-head"></span>
            <span class="figure-body"></span>
            <span class="figure-shadow"></span>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .hero {
    --hero-fill: 78%;
    padding: 118px 0 32px;
  }

  .hero-inner {
    min-height: calc(100svh + 120px);
    display: grid;
    grid-template-rows: auto 1fr auto auto auto;
    gap: 0;
  }

  .hero-top {
    grid-row: 1;
    display: flex;
    justify-content: space-between;
    gap: 32px;
    padding-top: 8px;
  }

  .hero-intro {
    display: grid;
    grid-template-columns: 64px minmax(0, 420px);
    gap: 18px;
    align-items: center;
    opacity: 0;
    transform: translateY(24px);
  }

  .hero-avatar {
    width: 64px;
    height: 64px;
    border-radius: 999px;
    border: 1px solid var(--line-strong);
    display: grid;
    place-items: center;
    font-family: var(--font-display);
    font-size: 22px;
    font-weight: 600;
    color: var(--text-primary);
    background:
      radial-gradient(circle at 50% 30%, rgba(255, 255, 255, 0.22), rgba(255, 255, 255, 0) 48%),
      rgba(255, 255, 255, 0.02);
  }

  .hero-intro-copy {
    font-family: var(--font-mono);
    font-size: 14px;
    color: var(--text-muted);
    line-height: 1.45;
  }

  .hero-heading {
    grid-row: 3;
    padding-top: clamp(220px, 24vh, 420px);
  }

  .hero-headline {
    font-family: var(--font-display);
    font-size: clamp(96px, 8.9vw, 128px);
    font-weight: 600;
    line-height: 0.92;
  }

  .line-wrap {
    display: block;
    overflow: hidden;
  }

  .line {
    display: block;
    transform: translateY(104%);
  }

  .hero-headline-solid {
    color: var(--text-primary);
  }

  .hero-headline-progress {
    color: transparent;
    background-image: linear-gradient(
      90deg,
      rgba(255, 255, 255, 0.36) 0 calc(100% - var(--hero-fill)),
      var(--text-primary) calc(100% - var(--hero-fill)) 100%
    );
    -webkit-background-clip: text;
    background-clip: text;
  }

  .hero-meta {
    grid-row: 4;
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr) auto;
    gap: 28px;
    align-items: center;
    padding: 60px 0 0;
    opacity: 0;
    transform: translateY(24px);
  }

  .hero-meta-segment {
    display: flex;
    align-items: center;
    gap: 18px;
  }

  .hero-meta-label {
    font-family: var(--font-mono);
    font-size: 13px;
    color: var(--text-muted);
    white-space: nowrap;
  }

  .hero-meta-rule {
    height: 1px;
    flex: 1 1 auto;
    background: var(--line);
  }

  .hero-availability {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-family: var(--font-mono);
    font-size: 13px;
    color: var(--accent);
    white-space: nowrap;
  }

  .availability-dot {
    width: 8px;
    height: 8px;
    border-radius: 999px;
    background: currentColor;
    box-shadow: 0 0 0 6px rgba(159, 213, 169, 0.12);
  }

  .hero-body {
    grid-row: 5;
    display: grid;
    grid-template-columns: minmax(0, 470px) minmax(320px, 440px);
    justify-content: space-between;
    align-items: start;
    gap: clamp(56px, 7vw, 120px);
    padding-top: 124px;
  }

  .hero-copy {
    display: flex;
    flex-direction: column;
    min-height: clamp(520px, 58vh, 720px);
    opacity: 0;
    transform: translateY(24px);
  }

  .hero-summary {
    font-family: var(--font-body);
    font-size: 23px;
    font-weight: 700;
    line-height: 1.48;
    margin-bottom: 0;
    max-width: 28rem;
  }

  .hero-summary-word {
    display: inline-block;
    color: rgba(255, 255, 255, 0.18);
    will-change: color;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 20px;
    margin-top: auto;
    padding-top: clamp(220px, 26vh, 360px);
  }

  .hero-action {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-family: var(--font-mono);
    font-size: 13px;
    color: var(--text-secondary);
    transition: color 0.2s ease;
  }

  .hero-action:hover,
  .hero-action:focus-visible {
    color: var(--text-primary);
  }

  .hero-portrait-shell {
    display: flex;
    justify-content: flex-end;
    align-self: end;
    opacity: 0;
    transform: translateY(24px);
  }

  .hero-portrait {
    position: relative;
    width: min(100%, 432px);
    aspect-ratio: 0.72;
    overflow: hidden;
    background:
      radial-gradient(circle at 50% 18%, rgba(255, 255, 255, 0.18), transparent 30%),
      linear-gradient(180deg, rgba(255, 255, 255, 0), rgba(11, 12, 12, 0.58) 74%),
      transparent;
  }

  .hero-portrait::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, rgba(11, 12, 12, 0), rgba(11, 12, 12, 0.34) 65%, rgba(11, 12, 12, 0.8));
    pointer-events: none;
  }

  .hero-portrait-note {
    position: absolute;
    top: 10px;
    left: 0;
    z-index: 1;
    font-family: var(--font-mono);
    font-size: 10px;
    color: rgba(255, 255, 255, 0.58);
  }

  .portrait-figure {
    position: absolute;
    inset: 0;
  }

  .figure-head {
    position: absolute;
    top: 16%;
    left: 54%;
    width: 94px;
    height: 94px;
    border-radius: 999px;
    background: radial-gradient(circle at 40% 35%, rgba(255, 255, 255, 0.14), rgba(255, 255, 255, 0.04) 58%, rgba(255, 255, 255, 0.01));
    transform: translateX(-50%);
  }

  .figure-body {
    position: absolute;
    left: 54%;
    bottom: -2%;
    width: 264px;
    height: 388px;
    border-radius: 148px 148px 32px 32px;
    background: linear-gradient(180deg, rgba(255, 255, 255, 0.13), rgba(255, 255, 255, 0.03) 34%, rgba(255, 255, 255, 0.01) 84%);
    transform: translateX(-50%);
    filter: blur(0.2px);
  }

  .figure-shadow {
    position: absolute;
    inset: auto auto 8% 50%;
    width: 288px;
    height: 288px;
    border-radius: 999px;
    background: radial-gradient(circle, rgba(255, 255, 255, 0.12), rgba(255, 255, 255, 0) 72%);
    transform: translateX(-40%);
    opacity: 0.4;
  }

  @media (max-width: 1120px) {
    .hero-body {
      grid-template-columns: minmax(0, 1fr) minmax(260px, 360px);
    }
  }

  @media (max-width: 860px) {
    .hero {
      padding-top: 104px;
    }

    .hero-inner {
      min-height: auto;
      grid-template-rows: auto auto auto auto;
      gap: 28px;
    }

    .hero-heading,
    .hero-meta,
    .hero-body {
      grid-row: auto;
    }

    .hero-heading {
      padding-top: 8px;
    }

    .hero-headline {
      font-size: 68px;
    }

    .hero-meta {
      grid-template-columns: 1fr;
      row-gap: 12px;
    }

    .hero-body {
      grid-template-columns: 1fr;
      justify-items: start;
      gap: 32px;
      padding-top: 8px;
    }

    .hero-portrait-shell {
      width: 100%;
      justify-content: flex-start;
    }

    .hero-copy {
      min-height: auto;
    }

    .hero-actions {
      margin-top: 0;
      padding-top: 72px;
    }
  }

  @media (max-width: 640px) {
    .hero-intro {
      grid-template-columns: 48px 1fr;
      gap: 12px;
    }

    .hero-avatar {
      width: 48px;
      height: 48px;
      font-size: 18px;
    }

    .hero-headline {
      font-size: 48px;
    }

    .hero-meta {
      gap: 10px;
    }

    .hero-actions {
      flex-direction: column;
      gap: 10px;
      padding-top: 56px;
    }

    .hero-meta-segment {
      gap: 12px;
    }

    .hero-summary {
      font-size: 19px;
      max-width: 100%;
    }

    .hero-portrait {
      width: min(100%, 320px);
    }
  }
</style>
