---
const profileLinks = [
  { label: 'View selected work', href: '#work' },
  { label: 'Open resume', href: '/cv.pdf', external: true },
  { label: 'Email Isaac', href: 'mailto:adeloreisaac@gmail.com' },
];

const proofPoints = [
  '6+ years shipping product UI across web, mobile, retail, and admin surfaces',
  '55% load-time reduction on a white-label sportsbook platform',
  'Client onboarding cut from weeks to days through reusable theming infrastructure',
  '100,000+ users served across gaming product work at LordwinGames',
];

const focusAreas = [
  'Frontend systems',
  'Realtime product surfaces',
  'Payments and transactional UI',
  'Full-stack delivery when product scope needs it',
];
---

<section class="hero" id="hero">
  <div class="shell hero-inner">
    <div class="hero-copy">
      <span class="eyebrow">Lagos, Nigeria / Available for senior product roles</span>
      <h1 class="hero-title">Frontend systems for products that move under pressure.</h1>
      <p class="hero-summary">
        I am a frontend-first engineer with full-stack delivery range. My strongest work lives in
        realtime, transactional, and multi-role products where the interface has to stay clear
        even when the underlying system is messy.
      </p>

      <div class="pill-row hero-pills">
        {focusAreas.map((area) => (
          <span class="pill">{area}</span>
        ))}
      </div>

      <div class="hero-actions">
        {profileLinks.map((link) => (
          <a
            href={link.href}
            class:list={['hero-action', link.external && 'hero-action--secondary']}
            target={link.external ? '_blank' : undefined}
            rel={link.external ? 'noreferrer' : undefined}
          >
            {link.label}
          </a>
        ))}
      </div>
    </div>

    <aside class="hero-proof card-surface" aria-label="Impact highlights">
      <div class="hero-proof-header">
        <p class="hero-proof-kicker">What a recruiter should know fast</p>
        <p class="hero-proof-note">
          Frontend depth is the through-line. Full-stack delivery shows up where product ownership
          requires it.
        </p>
      </div>

      <div class="hero-proof-list">
        {proofPoints.map((point, index) => (
          <article class="hero-proof-item">
            <span class="hero-proof-index">0{index + 1}</span>
            <p>{point}</p>
          </article>
        ))}
      </div>

      <div class="hero-proof-footer">
        <span>Current public proof sources:</span>
        <a href="https://github.com/loluskii/betpanta-mobile" target="_blank" rel="noreferrer">BetPanta Mobile</a>
        <a href="https://github.com/loluskii/9jadicev2" target="_blank" rel="noreferrer">9jaDice</a>
        <a href="https://github.com/loluskii/next-backoffice" target="_blank" rel="noreferrer">Next Backoffice</a>
      </div>
    </aside>
  </div>

  <div class="shell hero-strip">
    <div class="hero-strip-item">
      <span class="hero-strip-label">Primary edge</span>
      <strong>Frontend architecture that stays readable at product scale</strong>
    </div>
    <div class="hero-strip-item">
      <span class="hero-strip-label">Delivery range</span>
      <strong>React, Vue, Next.js, Nuxt, Laravel, Node, design-to-code execution</strong>
    </div>
    <div class="hero-strip-item">
      <span class="hero-strip-label">Best-fit products</span>
      <strong>Sportsbook, payments, communication tools, admin systems, marketplaces</strong>
    </div>
  </div>
</section>

<style>
  .hero {
    padding: 148px 0 40px;
  }

  .hero-inner {
    display: grid;
    grid-template-columns: minmax(0, 1.25fr) minmax(320px, 0.95fr);
    gap: 44px;
    align-items: start;
  }

  .hero-copy {
    display: grid;
    gap: 26px;
    padding-top: 14px;
  }

  .hero-title {
    max-width: 8.5ch;
    font-family: var(--font-display);
    font-size: clamp(52px, 8vw, 94px);
    line-height: 0.92;
    letter-spacing: -0.08em;
    text-transform: uppercase;
  }

  .hero-summary {
    max-width: 38rem;
    font-size: clamp(20px, 2.4vw, 27px);
    line-height: 1.5;
    color: var(--text-secondary);
  }

  .hero-pills {
    max-width: 44rem;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 14px;
  }

  .hero-action {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 48px;
    padding: 0 18px;
    border-radius: 999px;
    border: 1px solid rgba(214, 165, 111, 0.34);
    background: rgba(214, 165, 111, 0.1);
    font-family: var(--font-mono);
    font-size: 12px;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--accent-strong);
    transition: transform 0.2s ease, background 0.2s ease, border-color 0.2s ease;
  }

  .hero-action:hover,
  .hero-action:focus-visible {
    transform: translateY(-1px);
    border-color: rgba(214, 165, 111, 0.58);
    background: rgba(214, 165, 111, 0.14);
  }

  .hero-action--secondary {
    border-color: var(--line-strong);
    background: rgba(255, 255, 255, 0.02);
    color: var(--text-secondary);
  }

  .hero-action--secondary:hover,
  .hero-action--secondary:focus-visible {
    border-color: rgba(148, 163, 184, 0.48);
    background: rgba(255, 255, 255, 0.04);
  }

  .hero-proof {
    display: grid;
    gap: 22px;
    padding: 26px;
    border-radius: 26px;
  }

  .hero-proof-header {
    display: grid;
    gap: 10px;
  }

  .hero-proof-kicker {
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--text-muted);
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }

  .hero-proof-note {
    color: var(--text-secondary);
    max-width: 32ch;
  }

  .hero-proof-list {
    display: grid;
    gap: 16px;
  }

  .hero-proof-item {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 14px;
    padding-top: 16px;
    border-top: 1px solid var(--line);
  }

  .hero-proof-index {
    font-family: var(--font-display);
    font-size: 20px;
    line-height: 1;
    color: var(--accent);
    letter-spacing: -0.08em;
  }

  .hero-proof-item p {
    color: var(--text-secondary);
  }

  .hero-proof-footer {
    display: flex;
    flex-wrap: wrap;
    gap: 10px 14px;
    padding-top: 8px;
    border-top: 1px solid var(--line);
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--text-muted);
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }

  .hero-proof-footer a {
    color: var(--text-secondary);
  }

  .hero-strip {
    margin-top: 34px;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 18px;
  }

  .hero-strip-item {
    min-height: 148px;
    padding: 22px;
    border-top: 1px solid rgba(214, 165, 111, 0.32);
    background:
      linear-gradient(180deg, rgba(255, 255, 255, 0.03), transparent),
      rgba(8, 10, 15, 0.4);
  }

  .hero-strip-label {
    display: block;
    margin-bottom: 14px;
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--text-muted);
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }

  .hero-strip-item strong {
    font-size: 18px;
    line-height: 1.5;
    color: var(--text-secondary);
    font-weight: 700;
  }

  @media (max-width: 1080px) {
    .hero-inner {
      grid-template-columns: 1fr;
    }

    .hero-proof-note {
      max-width: none;
    }

    .hero-strip {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 720px) {
    .hero {
      padding-top: 126px;
    }

    .hero-proof {
      padding: 20px;
      border-radius: 22px;
    }

    .hero-strip-item {
      min-height: auto;
    }
  }
</style>
