---
const projects = [
  {
    title: 'Sportsbook Engine',
    year: '2022 - Present',
    role: 'Channels & Experience Lead / Senior Frontend Engineer',
    scope: ['Frontend architecture', 'White-label delivery', 'Realtime systems'],
    summary:
      'Owned the frontend architecture across web, mobile, retail terminals, and admin tools for a white-label sportsbook engine with live odds, casino flows, and multi-brand product delivery.',
    wins: [
      'Built theming and feature-toggle infrastructure that cut new client onboarding from weeks to days.',
      'Led realtime sportsbook and casino surfaces with live odds, betslip recalculations, and simulated game UI.',
      'Drove performance work that reduced load times by 55 percent while maintaining live updates at scale.',
    ],
    stack: ['Vue', 'Vuex', 'Pinia', 'TypeScript', 'WebSocket', 'Admin tooling'],
  },
  {
    title: 'Venmail',
    year: '2024 - 2025',
    role: 'Senior Software Engineer',
    scope: ['Frontend systems', 'Design fidelity', 'Product overhaul'],
    summary:
      'Rebuilt the frontend of a large Laravel and React application during a full company rebrand, replacing monolithic UI patterns with a cleaner component system and tighter product standards.',
    wins: [
      'Co-engineered a Gmail-style mailing suite with a rich-text composer, thread UX, and bulk actions.',
      'Built booking and calendar workflows tightly coupled with the core communication product.',
      'Integrated video conferencing directly into existing product flows without losing design consistency.',
    ],
    stack: ['React', 'TypeScript', 'Inertia.js', 'Laravel', 'Figma-to-code'],
  },
  {
    title: 'FeedxNG',
    year: '2022 - 2023',
    role: 'Fullstack Engineer',
    scope: ['Full-stack delivery', 'Payments', 'Marketplace product'],
    summary:
      'Owned the end-to-end build of a food services marketplace, from product design in Figma through a Laravel backend and a Vue and Nuxt frontend, including infrastructure and payments.',
    wins: [
      'Designed role-specific buyer and seller dashboards around the needs of each user type.',
      'Integrated Paystack, Flutterwave, and Zilla into one payment layer for multiple checkout flows.',
      'Handled deployment and environment setup across Heroku and AWS as part of the product build.',
    ],
    stack: ['Vue', 'Nuxt', 'Laravel', 'AWS', 'Heroku', 'Payments'],
  },
  {
    title: 'PressOne Africa',
    year: '2023',
    role: 'Web Engineer',
    scope: ['Browser calling', 'Operational UI', 'Reliability'],
    summary:
      'Built browser-based calling flows and operator-facing interface improvements inside a communication product where state accuracy and support visibility mattered more than surface polish.',
    wins: [
      'Integrated SIP.js for call transfers, availability status, airtime payments, and contact management.',
      'Standardized reusable Vue patterns to reduce repeated UI implementation across the platform.',
      'Added Sentry, Replay, and Crashlytics instrumentation to improve monitoring and post-launch stability.',
    ],
    stack: ['Vue', 'Vue Router', 'SIP.js', 'Sentry', 'Replay', 'Crashlytics'],
  },
];
---

<section class="work section" id="work">
  <div class="shell">
    <div class="section-header">
      <span class="eyebrow">Selected work</span>
      <h2 class="section-title">The work I would want a recruiter to remember.</h2>
      <p class="section-copy">
        These are the product stories that best show the range: frontend architecture, product
        rebuilds, realtime surfaces, and full-stack ownership where the product scope demanded it.
        Private product visuals are being restored separately. Public code proof is lower on the
        page.
      </p>
    </div>

    <div class="work-list">
      {projects.map((project) => (
        <article class="work-card card-surface">
          <div class="work-card-top">
            <div>
              <p class="work-year">{project.year}</p>
              <h3 class="work-card-title">{project.title}</h3>
              <p class="work-role">{project.role}</p>
            </div>
            <div class="pill-row">
              {project.scope.map((item) => (
                <span class="pill">{item}</span>
              ))}
            </div>
          </div>

          <div class="work-card-body">
            <div class="work-card-copy">
              <p class="work-summary">{project.summary}</p>
              <div class="pill-row work-stack">
                {project.stack.map((item) => (
                  <span class="pill">{item}</span>
                ))}
              </div>
            </div>

            <div class="work-card-proof">
              <p class="work-proof-title">What changed</p>
              <ul class="work-proof-list">
                {project.wins.map((win) => (
                  <li>{win}</li>
                ))}
              </ul>
            </div>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .work {
    padding-top: 24px;
  }

  .work-list {
    display: grid;
    gap: 22px;
  }

  .work-card {
    padding: 28px;
    border-radius: 26px;
  }

  .work-card-top {
    display: flex;
    justify-content: space-between;
    align-items: start;
    gap: 24px;
    padding-bottom: 22px;
    border-bottom: 1px solid var(--line);
  }

  .work-year {
    margin-bottom: 12px;
    font-family: var(--font-mono);
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--text-muted);
  }

  .work-card-title {
    font-family: var(--font-display);
    font-size: clamp(28px, 4vw, 44px);
    font-weight: 600;
    line-height: 0.98;
    letter-spacing: -0.06em;
    text-transform: uppercase;
  }

  .work-role {
    margin-top: 10px;
    max-width: 38rem;
    color: var(--text-secondary);
    font-size: 16px;
  }

  .work-card-body {
    display: grid;
    grid-template-columns: minmax(0, 1.15fr) minmax(280px, 0.85fr);
    gap: 26px;
    padding-top: 24px;
  }

  .work-card-copy {
    display: grid;
    gap: 22px;
  }

  .work-summary {
    max-width: 42rem;
    font-size: 18px;
    line-height: 1.75;
    color: var(--text-secondary);
  }

  .work-stack {
    padding-top: 4px;
  }

  .work-card-proof {
    padding: 20px;
    border: 1px solid var(--line);
    background: var(--panel-muted);
  }

  .work-proof-title {
    margin-bottom: 16px;
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--text-muted);
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }

  .work-proof-list {
    display: grid;
    gap: 12px;
    padding-left: 18px;
    color: var(--text-secondary);
  }

  .work-proof-list li::marker {
    color: var(--accent);
  }

  @media (max-width: 960px) {
    .work-card-body {
      grid-template-columns: 1fr;
    }

    .work-card {
      padding: 22px;
    }

    .work-card-top {
      flex-direction: column;
    }
  }

  @media (max-width: 520px) {
    .work-card-title {
      font-size: 24px;
    }

    .work-summary {
      font-size: 16px;
    }
  }
</style>
