---
const contactLinks = [
  { label: 'Email Isaac', href: 'mailto:adeloreisaac@gmail.com?subject=Portfolio%20Inquiry' },
  { label: 'Open GitHub', href: 'https://github.com/loluskii', external: true },
  { label: 'Open LinkedIn', href: 'https://linkedin.com/in/adeloreisaac', external: true },
  { label: 'Download CV', href: '/cv.pdf', external: true },
];
---

<section class="contact" id="contact">
  <div class="shell contact-inner">
    <div class="contact-copy">
      <span class="eyebrow">Contact</span>
      <h2 class="contact-title">If the role needs strong frontend judgment, I should be in the mix.</h2>
      <p class="contact-subtitle">
        Open to senior frontend and product engineering roles, contract work, and conversations
        where interface quality is tied to business risk, speed, or system complexity.
      </p>
    </div>

    <div class="contact-actions">
      {contactLinks.map((link) => (
        <a
          href={link.href}
          class="contact-action"
          target={link.external ? '_blank' : undefined}
          rel={link.external ? 'noreferrer' : undefined}
        >
          {link.label}
        </a>
      ))}
    </div>

    <div class="contact-footer">
      <span>Isaac Adelore, {new Date().getFullYear()}</span>
      <div class="contact-footer-links">
        <a href="https://linkedin.com/in/adeloreisaac" target="_blank" rel="noreferrer">LinkedIn</a>
        <a href="mailto:adeloreisaac@gmail.com">adeloreisaac@gmail.com</a>
      </div>
    </div>
  </div>
</section>

<style>
  .contact {
    padding: 0 0 32px;
  }

  .contact-inner {
    display: grid;
    gap: 34px;
  }

  .contact-title {
    font-family: var(--font-display);
    font-size: clamp(34px, 5vw, 56px);
    font-weight: 600;
    line-height: 1;
    letter-spacing: -0.05em;
    text-transform: uppercase;
    max-width: 13ch;
  }

  .contact-subtitle {
    max-width: 36rem;
    margin-top: 18px;
    font-size: 17px;
    color: var(--text-secondary);
    line-height: 1.7;
  }

  .contact-actions {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    border: 1px solid var(--line);
    background: rgba(255, 255, 255, 0.03);
  }

  .contact-action {
    min-height: 70px;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 16px;
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--text-secondary);
    border-right: 1px solid var(--line);
    transition: background 0.2s ease, color 0.2s ease;
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }

  .contact-action:last-child {
    border-right: 0;
  }

  .contact-action:hover,
  .contact-action:focus-visible {
    background: rgba(255, 255, 255, 0.05);
    color: var(--text-primary);
  }

  .contact-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--text-muted);
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }

  .contact-footer-links {
    display: flex;
    gap: 18px;
    flex-wrap: wrap;
  }

  @media (max-width: 960px) {
    .contact-actions {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 720px) {
    .contact-actions {
      grid-template-columns: 1fr;
    }

    .contact-action {
      border-right: 0;
      border-bottom: 1px solid var(--line);
    }

    .contact-action:last-child {
      border-bottom: 0;
    }

    .contact-footer {
      flex-direction: column;
      align-items: flex-start;
    }
  }
</style>
