<nav class="nav" id="nav">
  <div class="nav-inner shell">
    <a href="#hero" class="nav-brand" aria-label="Go to top of page" data-cursor-label="Top" data-cursor-tone="soft">
      <span class="nav-name">Isaac Adelore</span>
    </a>
    <div class="nav-progress" aria-hidden="true">
      <span class="nav-progress-track"></span>
      <span class="nav-progress-indicator" id="nav-progress-indicator"></span>
    </div>
    <div class="nav-links">
      <a href="#work" class="nav-link" data-cursor-label="Jump" data-cursor-tone="soft">Work</a>
      <a href="#about" class="nav-link" data-cursor-label="Jump" data-cursor-tone="soft">About</a>
      <a href="#writing" class="nav-link" data-cursor-label="Jump" data-cursor-tone="soft">Writing</a>
      <a href="#contact" class="nav-link" data-cursor-label="Jump" data-cursor-tone="soft">Contact</a>
    </div>
  </div>
</nav>

<style>
  .nav {
    position: fixed;
    inset: 0 0 auto;
    z-index: 100;
    padding: 22px 0;
    transition: background 0.25s ease, border-color 0.25s ease, backdrop-filter 0.25s ease;
  }

  .nav.scrolled {
    background: rgba(11, 12, 12, 0.84);
    border-bottom: 1px solid var(--line);
    backdrop-filter: blur(18px);
    -webkit-backdrop-filter: blur(18px);
  }

  .nav-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 54px;
  }

  .nav-brand {
    display: inline-flex;
    min-width: 0;
  }

  .nav-name {
    font-family: var(--font-display);
    font-size: 15px;
    font-weight: 600;
    color: var(--text-primary);
    line-height: 1;
  }

  .nav-progress {
    position: relative;
    flex: 1 1 auto;
    height: 1px;
    min-width: 240px;
  }

  .nav-progress-track,
  .nav-progress-indicator {
    position: absolute;
    inset: 0;
    border-radius: 999px;
  }

  .nav-progress-track {
    background: var(--line);
  }

  .nav-progress-indicator {
    inset: 0 auto 0 0;
    width: 0%;
    background: rgba(244, 243, 239, 0.86);
    box-shadow: 0 0 14px rgba(244, 243, 239, 0.16);
    will-change: width;
  }

  .nav-links {
    display: flex;
    align-items: center;
    gap: 28px;
  }

  .nav-link {
    font-family: var(--font-body);
    font-size: 15px;
    color: var(--text-secondary);
    transition: color 0.2s ease;
  }

  .nav-link:hover,
  .nav-link:focus-visible {
    color: var(--text-primary);
  }

  @media (max-width: 720px) {
    .nav {
      padding: 14px 0;
    }

    .nav-progress {
      display: none;
    }

    .nav-links {
      gap: 16px;
    }

    .nav-link {
      font-size: 13px;
    }
  }

  @media (max-width: 520px) {
    .nav-inner {
      align-items: flex-start;
    }

    .nav-links {
      flex-wrap: wrap;
      justify-content: flex-end;
      row-gap: 8px;
      max-width: 220px;
    }
  }
</style>
