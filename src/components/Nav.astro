---
import { navLinks, siteMeta } from '../data/portfolio';
---

<nav id="site-nav">
  <div class="shell nav-shell">
    <a class="brand" href="#top" aria-label={`${siteMeta.name} home`}>
      <span class="brand-mark">IA</span>
      <span class="brand-text">
        <span class="brand-name">{siteMeta.name}</span>
        <span class="brand-role">{siteMeta.role}</span>
      </span>
    </a>

    <div class="nav-links" aria-label="Section links">
      {navLinks.map((link) => (
        <a href={link.href} data-nav-link>
          {link.label}
        </a>
      ))}
    </div>

    <a class="nav-cta" href={`mailto:${siteMeta.email}`}>
      Email
      <span aria-hidden="true">↗</span>
    </a>
  </div>
</nav>
